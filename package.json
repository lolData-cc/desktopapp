{
  "name": "loldata-desktop",
  "version": "0.0.9",
  "private": true,
  "type": "module",
  "scripts": {
    "probe": "bun src/probe.ts",
    "build:main": "bun build shell/main.ts --target=node --format=esm --external electron --outfile shell/main.mjs && bun build shell/preload.ts --target=node --format=esm --external electron --outfile shell/preload.mjs",
    "dev": "concurrently -k -n vite,electron -c cyan,green \"vite\" \"bun run dev:electron\"",
    "dev:electron": "bun scripts/dev.ts",
    "build": "vite build && bun run build:main",
    "start": "bun run build:main && electron .",
    "dist": "bun run build && bun scripts/dist.ts",
    "dist:all": "bun run build && bun scripts/dist.ts --x64 --ia32 --arm64"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "3",
    "three": "^0.185.1",
    "typescript": "^5.6.0",
    "vite": "^8.2.2"
  },
  "main": "shell/main.mjs",
  "description": "The lolData companion for League of Legends.",
  "author": {
    "name": "lolData",
    "email": "hello@loldata.cc"
  }
}
