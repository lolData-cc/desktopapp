{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun",
      "node"
    ],
    "baseUrl": ".",
    "paths": { "@/*": ["src/renderer/*"] },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "shell",
    "scripts"
  ],
  "exclude": [
    "src/renderer/explorer",
    "src/renderer/ui",
    "src/renderer/hooks",
    "src/renderer/constants",
    "src/renderer/lib"
  ]
}